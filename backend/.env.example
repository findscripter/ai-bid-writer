# 复制为 .env 后按需修改（都可以不设，默认值适合本机单人使用）

# 把每次模型调用的请求与响应写到 backend/logs/（排查问题时打开；日志里会有招标内容）
# ENABLE_FILE_LOGGING=true

# 上传文件的大小上限（字节），默认 10MB
# MAX_FILE_SIZE=10485760

# 模型调用：流式响应里两次数据之间最长等多少秒；连接超时；限流/超时/5xx 的自动重试次数
# LLM_TIMEOUT_SECONDS=300
# LLM_CONNECT_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=3

# 招标文件超过多少字时改为“分段提取再合并”，以及每段多少字
# ANALYSIS_MAX_CHARS=90000
# ANALYSIS_SEGMENT_CHARS=30000

# 允许的 Host（JSON 数组）。只有确实要通过本机以外的地址访问时才需要改
# ALLOWED_HOSTS=["localhost","127.0.0.1"]

# 以下通过系统环境变量设置（不是写在 .env 里）：
#   AI_BID_HOME        数据目录（配置与项目工作区），默认 ~/.ai_write_helper
#   AI_BID_PORT        run.py 监听的端口，默认 8000
#   AI_BID_DEMO=1      演示模式：不需要 API Key，不联网，生成的是示意文本
#   AI_BID_STATIC_DIR  前端构建产物的目录，默认 backend/static
